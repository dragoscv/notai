{
    "name": "Notai",
    "short_name": "Notai",
    "description": "Calm notes with drawing, lists, and sticky notes.",
    "start_url": "/app",
    "scope": "/",
    "display": "standalone",
    "display_override": [
        "window-controls-overlay",
        "standalone"
    ],
    "background_color": "#fbfaf5",
    "theme_color": "#fbfaf5",
    "orientation": "any",
    "categories": [
        "productivity",
        "utilities"
    ],
    "icons": [
        { "src": "/icons/icon-32.png", "sizes": "32x32", "type": "image/png" },
        { "src": "/icons/icon-64.png", "sizes": "64x64", "type": "image/png" },
        { "src": "/icons/icon-128.png", "sizes": "128x128", "type": "image/png" },
        { "src": "/icons/icon-256.png", "sizes": "256x256", "type": "image/png" },
        { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "/icons/icon-1024.png", "sizes": "1024x1024", "type": "image/png", "purpose": "any maskable" }
    ],
    "share_target": {
        "action": "/app?share=1",
        "method": "GET",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url"
        }
    },
    "shortcuts": [
        {
            "name": "New note",
            "short_name": "New",
            "description": "Start a fresh note",
            "url": "/app?new=1",
            "icons": [{ "src": "/icons/icon-128.png", "sizes": "128x128" }]
        },
        {
            "name": "Quick capture",
            "short_name": "Capture",
            "description": "Capture a thought as a sticky",
            "url": "/app/quick-capture",
            "icons": [{ "src": "/icons/icon-128.png", "sizes": "128x128" }]
        },
        {
            "name": "Ask my notes",
            "short_name": "Ask",
            "description": "AI search across your notes",
            "url": "/app?ask=1",
            "icons": [{ "src": "/icons/icon-128.png", "sizes": "128x128" }]
        }
    ],
    "screenshots": [
        {
            "src": "/icons/icon-1024.png",
            "sizes": "1024x1024",
            "type": "image/png",
            "form_factor": "wide",
            "label": "The main note workspace"
        }
    ],
    "protocol_handlers": [
        {
            "protocol": "web+notai",
            "url": "/app/n/%s"
        }
    ]
}