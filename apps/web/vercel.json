{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@notai/web",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "outputDirectory": ".next",
  "ignoreCommand": "node ../../scripts/vercel-should-build.mjs",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/purge-trash",
      "schedule": "13 3 * * *"
    },
    {
      "path": "/api/cron/embed-notes",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/daily-note",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/push-daily-review",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/webhook-hygiene",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/purge-pending-deletions",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/cron/daily-digest",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/webhook-worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/purge-audit-log",
      "schedule": "55 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
