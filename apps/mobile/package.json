{
  "name": "@notai/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Capacitor wrapper for the Notai web app (Android + iOS).",
  "scripts": {
    "init": "echo \"Run: pnpm cap add android && pnpm cap add ios (after deps installed)\"",
    "sync": "cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "run:ios": "cap run ios",
    "doctor": "cap doctor",
    "assets": "capacitor-assets generate --assetPath assets"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.1"
  }
}
