{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Notai",
    "version": "0.1.7",
    "identifier": "dev.notai.desktop",
    "build": {
        "beforeDevCommand": "",
        "devUrl": "http://localhost:3000",
        "beforeBuildCommand": "",
        "frontendDist": "./frontend"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Notai",
                "url": "http://localhost:3000/app",
                "width": 1200,
                "height": 800,
                "minWidth": 720,
                "minHeight": 480,
                "decorations": true,
                "transparent": false,
                "dragDropEnabled": true
            }
        ],
        "security": {
            "csp": null
        },
        "trayIcon": {
            "id": "main",
            "iconPath": "icons/icon.png",
            "iconAsTemplate": true,
            "menuOnLeftClick": false
        }
    },
    "bundle": {
        "active": true,
        "createUpdaterArtifacts": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "category": "Productivity",
        "shortDescription": "Calm, collaborative notes with sticky-note windows",
        "longDescription": "Notai is a realtime notes app with drawing and sticky notes pinned above every other window."
    },
    "plugins": {
        "deep-link": {
            "desktop": {
                "schemes": [
                    "notai"
                ]
            }
        },
        "updater": {
            "active": true,
            "dialog": false,
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDREMDAxMjY5MjIwMTQ0MjYKUldRbVJBRWlhUklBVFRLYlFsbXVBSkhxbmVmbUlpMVZMMm1QQU9RcjEydkxtazBhUTQ5MDhqNW8K",
            "endpoints": [
                "https://github.com/dragoscv/notai/releases/latest/download/latest.json"
            ]
        }
    }
}