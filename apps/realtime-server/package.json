        "yjs": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "esbuild": "^0.25.0",
        "rimraf": "^6.0.1",
        "tsx": "catalog:",
        "typescript": "catalog:"
    }
