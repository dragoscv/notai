# ==========================================================================
# Notai — copy to .env.local for local dev. NEVER commit real secrets.
# ==========================================================================

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:15600
NEXT_PUBLIC_HOCUSPOCUS_URL=ws://localhost:15601

# ---- Database (local Docker default; for Neon paste your pooled URL) ----
DATABASE_URL=postgres://notai:notai@localhost:15602/notai

# ---- Auth.js v5 ----
# Generate: `openssl rand -base64 32`  or  `pnpm dlx auth secret`
AUTH_SECRET=replace-with-random-32-byte-base64
AUTH_TRUST_HOST=true

# ---- Google OAuth ----
# Create at https://console.cloud.google.com/apis/credentials (project: notai-prod)
# Authorized redirect URIs:
#   http://localhost:15600/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Hocuspocus realtime server ----
# Must match between web app (server-side signing) and hocuspocus (verification)
HOCUSPOCUS_JWT_SECRET=replace-with-random-32-byte-base64
HOCUSPOCUS_PORT=15601

# ==========================================================================
# Optional features — every block below is OFF by default. Enabling a block
# unlocks the matching feature; missing keys never crash the app, the
# feature just stays hidden / disabled.
# ==========================================================================

# ---- Email (Resend) ----
# Required in production for invites + contact form. In dev we log + succeed.
RESEND_API_KEY=
CONTACT_INBOX=
CONTACT_FROM=Notai <hello@notai.ro>

# ---- Rate-limit backend (optional) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Observability — Sentry (web + realtime) ----
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

# ---- Product analytics — PostHog (EU host) ----
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---- Asset uploads (S3-compatible: Cloudflare R2 or GCS HMAC) ----
# `provider` is informational; the SigV4 client only reads endpoint + creds.
ASSETS_PROVIDER=r2
ASSETS_BUCKET=notai-assets
ASSETS_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
ASSETS_REGION=auto
ASSETS_ACCESS_KEY_ID=
ASSETS_SECRET_ACCESS_KEY=
# Public CDN base URL — defaults to <endpoint>/<bucket> if blank.
ASSETS_PUBLIC_BASE_URL=

# ---- Per-user AI provider secrets (encryption) ----
# OPTIONAL. AES-256-GCM key for encrypting stored OpenAI/Copilot creds in
# the user_secrets table. If unset, derived from AUTH_SECRET via HKDF.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=

# ---- AI — OpenAI (server-wide fallback for the embedding cron only) ----
# End-users add their own keys (or connect GitHub Copilot) under
# Settings → AI providers. These vars are NOT required.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# ---- Billing — Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Cron ----
# Vercel cron sends `x-vercel-cron: 1` automatically; this is a fallback
# for self-hosted deployments where the scheduler can attach a header.
CRON_SECRET=replace-with-random-32-byte-base64

# ---- Realtime server's own Sentry DSN (defaults to SENTRY_DSN if unset) ----
# REALTIME_SENTRY_DSN=
