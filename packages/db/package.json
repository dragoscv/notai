{
  "name": "@notai/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./rbac-config": "./src/rbac-config.ts",
    "./plans-config": "./src/plans-config.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "push": "drizzle-kit push",
    "studio": "drizzle-kit studio",
    "seed": "tsx src/seed.ts",
    "seed:templates": "tsx src/seed-templates.ts",
    "seed:platform": "tsx src/seed-platform.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "@neondatabase/serverless": "catalog:",
    "next-auth": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "rimraf": "^6.0.1",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
