{
  "name": "@notai/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript client for the Notai REST API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dragoscv/notai",
    "directory": "packages/sdk"
  },
  "keywords": [
    "notai",
    "notes",
    "api",
    "client",
    "sdk"
  ],
  "homepage": "https://notai.app/developers/api",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "catalog:"
  }
}
