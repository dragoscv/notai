#!/usr/bin/env sh
# Conventional Commits validator (loose): require type(scope?): subject
# Allowed types: feat, fix, chore, refactor, docs, test, perf, ci, style, build, revert
msg_file="$1"
first_line="$(head -n1 "$msg_file")"

# Allow merge / revert commits and fixup/squash autosquashes
case "$first_line" in
    Merge*|Revert*|"fixup!"*|"squash!"*) exit 0 ;;
esac

pattern='^(feat|fix|chore|refactor|docs|test|perf|ci|style|build|revert)(\([a-zA-Z0-9_/-]+\))?!?: .{1,100}$'
if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
    echo "✖ Commit message does not follow Conventional Commits."
    echo "  Expected: type(scope)?: subject  (≤100 chars)"
    echo "  Allowed types: feat, fix, chore, refactor, docs, test, perf, ci, style, build, revert"
    echo "  Got: $first_line"
    exit 1
fi
