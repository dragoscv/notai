#!/usr/bin/env sh
# Pre-commit gate: format ONLY the files THIS commit changes (index blob vs the upstream base),
# so a file another agent staged without this commit touching it is never reformatted or
# re-staged. Then enforce a CHANGELOG entry on any package.json version bump.
# Lint + typecheck run on pre-push.
node scripts/precommit-format-staged.mjs || exit 1
node scripts/check-changelog.mjs || exit 1
